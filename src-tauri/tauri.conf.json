{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aeolus",
  "version": "0.1.5",
  "identifier": "dev.aeolus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aeolus",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Aeolus",
    "copyright": "Aeolus contributors",
    "category": "Utility",
    "shortDescription": "Roblox bootstrapper and client manager",
    "longDescription": "Aeolus installs, updates and launches the Roblox client through Roblox's official distribution, and manages Fast Flags, profiles and diagnostics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
